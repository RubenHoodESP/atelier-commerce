{
  "openapi": "3.1.0",
  "info": {
    "title": "Atelier Mock Commerce Provider",
    "version": "0.3.0",
    "description": "Local fictional commerce and editorial modules. Product list, detail, brand content and in-memory guest carts implemented; order POST remains planned for M3."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4100",
      "description": "Local fictional provider"
    }
  ],
  "paths": {
    "/products": {
      "get": {
        "operationId": "getProducts",
        "parameters": [
          {
            "name": "collection",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "horizon",
                "meridian",
                "nocturne"
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "featured",
                "price-asc",
                "price-desc",
                "name-asc"
              ],
              "default": "featured"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderCatalog"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or repeated catalog query"
          }
        }
      }
    },
    "/content/brand": {
      "get": {
        "operationId": "getBrandContent",
        "responses": {
          "200": {
            "description": "Successful read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderBrand"
                }
              }
            }
          }
        }
      }
    },
    "/products/{id}": {
      "get": {
        "operationId": "getProduct",
        "summary": "Read one fictional product",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^watch-[0-9]{3}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Vendor-shaped product, normalized by the Express BFF adapter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderProduct"
                }
              }
            }
          },
          "404": {
            "description": "Unknown vendor SKU",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "string",
                      "const": "Unknown SKU"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "post": {
        "operationId": "createOrder",
        "summary": "Atomically validate server prices and stock and accept a simulated order",
        "description": "Planned M3 operation; not implemented in M1. Same key and body return the same order. Reusing a key with another body is a conflict. In-memory state resets on restart. Product IDs must be unique within the request.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 100
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderInput"
              },
              "example": {
                "items": [
                  {
                    "productId": "watch-001",
                    "quantity": 2
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Idempotent replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Failure"
          },
          "404": {
            "$ref": "#/components/responses/Failure"
          },
          "409": {
            "$ref": "#/components/responses/Failure"
          },
          "500": {
            "$ref": "#/components/responses/Failure"
          }
        }
      }
    },
    "/carts": {
      "post": {
        "operationId": "createProviderCart",
        "summary": "Create an empty fixture cart",
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderCart"
                }
              }
            }
          }
        }
      }
    },
    "/carts/{id}": {
      "get": {
        "operationId": "getProviderCart",
        "summary": "Read a fixture cart priced from current fixtures",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cart",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderCart"
                }
              }
            }
          },
          "404": {
            "description": "cart_not_found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderCartError"
                }
              }
            }
          }
        }
      }
    },
    "/carts/{id}/lines": {
      "post": {
        "operationId": "addProviderCartLine",
        "summary": "Increment a cart line after checking current stock (no reservation)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderCartLineInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderCart"
                }
              }
            }
          },
          "400": {
            "description": "invalid_line",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderCartError"
                }
              }
            }
          },
          "404": {
            "description": "cart_not_found or unknown_sku",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderCartError"
                }
              }
            }
          },
          "409": {
            "description": "insufficient_stock, line_limit or quantity_limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderCartError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProviderCatalog": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "count"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderProduct"
            }
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ProviderBrand": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hero_title",
          "hero_text",
          "brand_story"
        ],
        "properties": {
          "hero_title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "hero_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "brand_story": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "ProviderProduct": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sku",
          "display_name",
          "collection_name",
          "unit_price",
          "available_units"
        ],
        "properties": {
          "sku": {
            "type": "string",
            "pattern": "^watch-[0-9]{3}$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "collection_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "unit_price": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cents",
              "currency_code"
            ],
            "properties": {
              "cents": {
                "type": "integer",
                "minimum": 0
              },
              "currency_code": {
                "type": "string",
                "const": "EUR"
              }
            }
          },
          "available_units": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Money": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "amountMinor",
          "currency"
        ],
        "properties": {
          "amountMinor": {
            "type": "integer",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "const": "EUR"
          }
        }
      },
      "Product": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "collection",
          "price",
          "stock"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "collection": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          },
          "stock": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "OrderItemInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "productId",
          "quantity"
        ],
        "properties": {
          "productId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        }
      },
      "OrderInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "$ref": "#/components/schemas/OrderItemInput"
            }
          }
        }
      },
      "OrderLine": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "productId",
          "quantity",
          "unitPrice"
        ],
        "properties": {
          "productId": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "unitPrice": {
            "$ref": "#/components/schemas/Money"
          }
        }
      },
      "Order": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "items",
          "total"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "const": "confirmed"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "$ref": "#/components/schemas/OrderLine"
            }
          },
          "total": {
            "$ref": "#/components/schemas/Money"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_INPUT",
              "PRODUCT_NOT_FOUND",
              "OUT_OF_STOCK",
              "IDEMPOTENCY_CONFLICT",
              "INTERNAL_ERROR"
            ]
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "ProviderCart": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cart_id",
          "entries",
          "total_units",
          "subtotal"
        ],
        "description": "In-memory fixture cart; resets on restart and is evicted beyond a bounded count.",
        "properties": {
          "cart_id": {
            "type": "string",
            "format": "uuid"
          },
          "total_units": {
            "type": "integer",
            "minimum": 0
          },
          "subtotal": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cents",
              "currency_code"
            ],
            "properties": {
              "cents": {
                "type": "integer",
                "minimum": 0
              },
              "currency_code": {
                "type": "string",
                "const": "EUR"
              }
            }
          },
          "entries": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sku",
                "display_name",
                "qty",
                "unit_price",
                "line_total"
              ],
              "properties": {
                "sku": {
                  "type": "string"
                },
                "display_name": {
                  "type": "string"
                },
                "qty": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "unit_price": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "cents",
                    "currency_code"
                  ],
                  "properties": {
                    "cents": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "currency_code": {
                      "type": "string",
                      "const": "EUR"
                    }
                  }
                },
                "line_total": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "cents",
                    "currency_code"
                  ],
                  "properties": {
                    "cents": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "currency_code": {
                      "type": "string",
                      "const": "EUR"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "ProviderCartLineInput": {
        "type": "object",
        "required": [
          "sku",
          "qty"
        ],
        "properties": {
          "sku": {
            "type": "string"
          },
          "qty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        }
      },
      "ProviderCartError": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "cart_not_found",
              "invalid_line",
              "unknown_sku",
              "insufficient_stock",
              "line_limit",
              "quantity_limit"
            ]
          }
        }
      }
    },
    "responses": {
      "Failure": {
        "description": "Safe provider failure",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
