{
  "openapi": "3.1.0",
  "info": {
    "title": "Atelier Express Integration API",
    "version": "0.2.0",
    "description": "Normalized product, catalog and editorial REST boundary. Writes remain planned for M3."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4000"
    }
  ],
  "paths": {
    "/api/products/{id}": {
      "get": {
        "operationId": "getProduct",
        "summary": "Get a normalized fictional product",
        "description": "Only the path identifier is accepted. Unexpected query parameters are rejected.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^watch-[0-9]{3}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Normalized product",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated correlation ID",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductSuccess"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_INPUT",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated correlation ID",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductFailure"
                }
              }
            }
          },
          "404": {
            "description": "PRODUCT_NOT_FOUND",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated correlation ID",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductFailure"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated correlation ID",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductFailure"
                }
              }
            }
          },
          "502": {
            "description": "UPSTREAM_UNAVAILABLE or UPSTREAM_INVALID_RESPONSE",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated correlation ID",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductFailure"
                }
              }
            }
          },
          "504": {
            "description": "UPSTREAM_TIMEOUT",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated correlation ID",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductFailure"
                }
              }
            }
          }
        }
      }
    },
    "/api/products": {
      "get": {
        "operationId": "getProducts",
        "description": "Unexpected or repeated query parameters are rejected. Catalog totals equal the returned list length; duplicate product IDs are invalid.",
        "parameters": [
          {
            "name": "collection",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "horizon",
                "meridian",
                "nocturne"
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "featured",
                "price-asc",
                "price-desc",
                "name-asc"
              ],
              "default": "featured"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogSuccess"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_INPUT",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated correlation ID",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductFailure"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated correlation ID",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductFailure"
                }
              }
            }
          },
          "502": {
            "description": "UPSTREAM_UNAVAILABLE or UPSTREAM_INVALID_RESPONSE",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated correlation ID",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductFailure"
                }
              }
            }
          },
          "504": {
            "description": "UPSTREAM_TIMEOUT",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated correlation ID",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductFailure"
                }
              }
            }
          }
        }
      }
    },
    "/api/content/brand": {
      "get": {
        "operationId": "getBrandContent",
        "description": "Unexpected or repeated query parameters are rejected. Catalog totals equal the returned list length; duplicate product IDs are invalid.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContentSuccess"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_INPUT",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated correlation ID",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductFailure"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated correlation ID",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductFailure"
                }
              }
            }
          },
          "502": {
            "description": "UPSTREAM_UNAVAILABLE or UPSTREAM_INVALID_RESPONSE",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated correlation ID",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductFailure"
                }
              }
            }
          },
          "504": {
            "description": "UPSTREAM_TIMEOUT",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated correlation ID",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductFailure"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Money": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "amountMinor",
          "currency"
        ],
        "properties": {
          "amountMinor": {
            "type": "integer",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "const": "EUR"
          }
        }
      },
      "Product": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "collection",
          "price",
          "stock"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^watch-[0-9]{3}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "collection": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          },
          "stock": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ProductSuccess": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "product"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "product": {
            "$ref": "#/components/schemas/Product"
          }
        }
      },
      "ProductFailure": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "error"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_INPUT",
                  "PRODUCT_NOT_FOUND",
                  "UPSTREAM_UNAVAILABLE",
                  "UPSTREAM_INVALID_RESPONSE",
                  "UPSTREAM_TIMEOUT",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "requestId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "CatalogSuccess": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "products",
          "total"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "BrandContent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "headline",
          "intro",
          "story"
        ],
        "properties": {
          "headline": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "intro": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "story": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "ContentSuccess": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "content"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "content": {
            "$ref": "#/components/schemas/BrandContent"
          }
        }
      }
    }
  }
}
