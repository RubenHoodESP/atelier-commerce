{
  "openapi": "3.1.0",
  "info": {
    "title": "Atelier Express Integration API",
    "version": "0.3.0",
    "description": "Normalized product, catalog, editorial and guest-cart REST boundary. Called by the Next server only. Orders remain planned for M3."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4000"
    }
  ],
  "paths": {
    "/api/products/{id}": {
      "get": {
        "operationId": "getProduct",
        "summary": "Get a normalized fictional product",
        "description": "Only the path identifier is accepted. Unexpected query parameters are rejected.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^watch-[0-9]{3}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Normalized product",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated correlation ID",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductSuccess"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_INPUT",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated correlation ID",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductFailure"
                }
              }
            }
          },
          "404": {
            "description": "PRODUCT_NOT_FOUND",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated correlation ID",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductFailure"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated correlation ID",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductFailure"
                }
              }
            }
          },
          "502": {
            "description": "UPSTREAM_UNAVAILABLE or UPSTREAM_INVALID_RESPONSE",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated correlation ID",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductFailure"
                }
              }
            }
          },
          "504": {
            "description": "UPSTREAM_TIMEOUT",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated correlation ID",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductFailure"
                }
              }
            }
