  "components": {
    "schemas": {
      "Money": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "amountMinor",
          "currency"
        ],
        "properties": {
          "amountMinor": {
            "type": "integer",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "const": "EUR"
          }
        }
      },
      "Product": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "collection",
          "price",
          "stock"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^watch-[0-9]{3}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "collection": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          },
          "stock": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ProductSuccess": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "product"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "product": {
            "$ref": "#/components/schemas/Product"
          }
        }
      },
      "ProductFailure": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "error"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_INPUT",
                  "PRODUCT_NOT_FOUND",
                  "CART_NOT_FOUND",
                  "OUT_OF_STOCK",
                  "CART_LIMIT_EXCEEDED",
                  "UPSTREAM_UNAVAILABLE",
                  "UPSTREAM_INVALID_RESPONSE",
                  "UPSTREAM_TIMEOUT",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "requestId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "CatalogSuccess": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "products",
          "total"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "BrandContent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "headline",
          "intro",
          "story"
        ],
        "properties": {
          "headline": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "intro": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "story": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "ContentSuccess": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "content"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "content": {
            "$ref": "#/components/schemas/BrandContent"
          }
        }
      },
      "CartLine": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "productId",
          "name",
          "quantity",
          "unitPrice",
          "lineTotal"
        ],
        "description": "lineTotal.amountMinor equals unitPrice.amountMinor * quantity.",
        "properties": {
          "productId": {
            "type": "string",
            "pattern": "^watch-[0-9]{3}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "unitPrice": {
            "$ref": "#/components/schemas/Money"
          },
          "lineTotal": {
            "$ref": "#/components/schemas/Money"
          }
        }
      },
      "Cart": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "lines",
          "itemCount",
          "subtotal"
        ],
        "description": "Prices and totals are calculated by commerce. itemCount and subtotal equal the sums of the lines; product IDs are unique.",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "lines": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "$ref": "#/components/schemas/CartLine"
            }
          },
          "itemCount": {
            "type": "integer",
            "minimum": 0
          },
          "subtotal": {
            "$ref": "#/components/schemas/Money"
          }
        }
      },
      "CartSuccess": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "cart"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "cart": {
            "$ref": "#/components/schemas/Cart"
          }
        }
      },
      "CartItemInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "productId",
          "quantity"
        ],
        "description": "Only an ID and a quantity. Any price or total field makes the request invalid.",
        "properties": {
          "productId": {
            "type": "string",
            "pattern": "^watch-[0-9]{3}$"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        }
      }
    }
  }
}
