          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "featured",
                "price-asc",
                "price-desc",
                "name-asc"
              ],
              "default": "featured"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful read",
