# Server-only addresses. Copy to .env in the repository root for npm run dev/start.
PROVIDER_PORT=4100
PROVIDER_URL=http://127.0.0.1:4100
PROVIDER_TIMEOUT_MS=1500
MIDDLEWARE_PORT=4000
COMMERCE_API_URL=http://127.0.0.1:4000/api
COMMERCE_API_TIMEOUT_MS=2500
PORT=3000
# Shared secret between the storefront and a BFF reachable over the network (deployment only).
# Leave unset locally: the BFF then requires no token. Required by scripts/serve-backend.mjs in
# production; at least 32 characters. Never commit a real value.
# BFF_API_TOKEN=
